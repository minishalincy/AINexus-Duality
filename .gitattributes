# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

# Ensure those files that are certainly text have strict settings.
*.md text
*.json text
*.js text
*.ts text
*.tsx text
*.py text
*.css text
*.html text
*.txt text

# Verify binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
